---
import TagBadge from '../components/TagBadge.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      updatedDate?: Date;
      tags: string[];
      lang: 'en' | 'zh';
    };
  };
}

const { post } = Astro.props;
const dateStr = post.data.pubDate.toISOString().slice(0, 10);
const langLabel = post.data.lang === 'zh' ? '中文' : 'English';
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
  <header class="border-b border-slate-200 pb-8 dark:border-slate-800">
    <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
      <span class="rounded-full border border-brand/30 px-2.5 py-0.5 text-xs font-medium text-brand dark:border-sky-400/40 dark:text-sky-300">
        {langLabel}
      </span>
      <time datetime={dateStr}>{dateStr}</time>
      {post.data.updatedDate && (
        <span>更新于 {post.data.updatedDate.toISOString().slice(0, 10)}</span>
      )}
    </div>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      {post.data.title}
    </h1>
    {post.data.description && (
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">{post.data.description}</p>
    )}
    {post.data.tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )}
  </header>

  <div class="blog-prose mt-8">
    <slot />
  </div>
</article>
