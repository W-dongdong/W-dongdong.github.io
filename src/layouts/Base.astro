---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

const siteName = 'WU Yandong';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Writing`} href="/rss.xml" />
    <ClientRouter />
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var mode = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
        var resolved = mode === 'light' || mode === 'dark'
          ? mode
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', resolved);

        // Arm scroll-reveal before first paint so nothing flashes in visible and
        // then jumps. Only armed when we can actually reveal things again.
        try {
          if (
            'IntersectionObserver' in window &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            document.documentElement.classList.add('reveal-ready');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased text-ink">
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    <MusicPlayer />

    <script>
      // --- Scroll reveal -------------------------------------------------
      // ClientRouter swaps the page body on navigation, so re-arm the class on
      // <html> and re-observe whatever `[data-reveal]` elements now exist.
      var canReveal = function () {
        return (
          'IntersectionObserver' in window &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        );
      };

      var observer: IntersectionObserver | null = null;

      function observeReveals() {
        if (!observer) return;
        document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach(function (el) {
          observer!.observe(el);
        });
      }

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer!.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
      }

      // `before-swap` hands us the incoming document *before* it is applied.
      // ClientRouter copies the server-rendered <html> attributes onto the live
      // element, and those do not carry the class added here at runtime — so
      // arming it in `after-swap` lands a frame too late and the browser paints a
      // flash of fully-visible content. Arm the incoming document instead.
      document.addEventListener('astro:before-swap', function (event: any) {
        var incoming: Document | undefined = event.newDocument;
        if (incoming && canReveal()) incoming.documentElement.classList.add('reveal-ready');
      });

      document.addEventListener('astro:after-swap', function () {
        if (canReveal()) {
          // Whatever lands in the first screenful of the incoming page should
          // simply be there. Only content further down animates in as it is
          // scrolled to — otherwise every click reads as the page fading in
          // twice, once in the view-transition cross-fade and again in the
          // reveal.
          //
          // This has to happen here, synchronously: the browser snapshots the
          // new state once the swap callback returns, so marking them in the
          // observer's first batch would put an empty page in that snapshot.
          // Measuring against the document rather than the viewport keeps it
          // independent of when the scroll position gets reset.
          var fold = window.innerHeight;
          document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach(function (el) {
            var node = el as HTMLElement;
            if (node.getBoundingClientRect().top + window.scrollY >= fold) return;
            node.style.transition = 'none';
            node.classList.add('is-visible');
            requestAnimationFrame(function () {
              node.style.transition = '';
            });
          });
        }
        observeReveals();
      });

      observeReveals();
    </script>
  </body>
</html>
