---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

const siteName = 'WU Yandong';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Writing`} href="/rss.xml" />
    <ClientRouter />
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var mode = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
        var resolved = mode === 'light' || mode === 'dark'
          ? mode
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', resolved);

        // Rail width for series pages, remembered from the last drag. Read here
        // so the rail is already the right width on the first paint.
        try {
          var railW = parseInt(localStorage.getItem('rail-w') || '', 10);
          if (railW > 100 && railW < 1000) {
            document.documentElement.style.setProperty('--rail-w', railW + 'px');
          }
        } catch (e) {}

        // Arm scroll-reveal before first paint so nothing flashes in visible and
        // then jumps. Only armed when we can actually reveal things again.
        try {
          if (
            'IntersectionObserver' in window &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            document.documentElement.classList.add('reveal-ready');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased text-ink">
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    <MusicPlayer />

    <script>
      // --- Copy buttons on code blocks ------------------------------------
      // Wrapped client-side so the markdown keeps rendering plain <pre><code>:
      // the button sits outside the <pre>, which scrolls sideways on its own.
      const COPY_ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
        '<rect x="9" y="9" width="13" height="13" rx="2" />' +
        '<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>';
      const DONE_ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
        '<polyline points="20 6 9 17 4 12" /></svg>';
      const FAIL_ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
        '<line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>';

      function legacyCopy(text: string): boolean {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.top = '-1000px';
        area.style.opacity = '0';
        document.body.append(area);
        area.select();

        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }

      function addCopyButtons() {
        document.querySelectorAll<HTMLElement>('.blog-prose pre').forEach((pre) => {
          if (pre.parentElement?.classList.contains('code-block')) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block';
          pre.replaceWith(wrapper);
          wrapper.append(pre);

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'code-copy';
          button.title = '复制代码';
          button.setAttribute('aria-label', '复制代码');
          button.innerHTML =
            '<span class="code-copy__icon">' +
            COPY_ICON +
            '</span><span class="sr-only" data-state>复制代码</span>';
          wrapper.append(button);

          const icon = button.querySelector('.code-copy__icon')!;
          const state = button.querySelector('[data-state]')!;
          let timer = 0;

          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';

            let ok = true;
            try {
              await navigator.clipboard.writeText(code);
            } catch {
              // No clipboard API outside a secure context — fall back.
              ok = legacyCopy(code);
            }

            button.classList.toggle('is-done', ok);
            button.classList.toggle('is-failed', !ok);
            icon.innerHTML = ok ? DONE_ICON : FAIL_ICON;

            const message = ok ? '已复制' : '复制失败';
            button.title = message;
            button.setAttribute('aria-label', message);
            state.textContent = message;

            window.clearTimeout(timer);
            timer = window.setTimeout(() => {
              button.classList.remove('is-done', 'is-failed');
              icon.innerHTML = COPY_ICON;
              button.title = '复制代码';
              button.setAttribute('aria-label', '复制代码');
              state.textContent = '复制代码';
            }, 1600);
          });
        });
      }

      document.addEventListener('astro:page-load', addCopyButtons);

      // --- Scroll reveal -------------------------------------------------
      // ClientRouter swaps the page body on navigation, so re-arm the class on
      // <html> and re-observe whatever `[data-reveal]` elements now exist.
      var canReveal = function () {
        return (
          'IntersectionObserver' in window &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        );
      };

      var observer: IntersectionObserver | null = null;

      function observeReveals() {
        if (!observer) return;
        document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach(function (el) {
          observer!.observe(el);
        });
      }

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer!.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
      }

      // `before-swap` hands us the incoming document *before* it is applied.
      // ClientRouter copies the server-rendered <html> attributes onto the live
      // element, and those do not carry the class added here at runtime — so
      // arming it in `after-swap` lands a frame too late and the browser paints a
      // flash of fully-visible content. Arm the incoming document instead.
      document.addEventListener('astro:before-swap', function (event: any) {
        var incoming: Document | undefined = event.newDocument;
        if (incoming && canReveal()) incoming.documentElement.classList.add('reveal-ready');

        // The swap copies the incoming <html> over the live one, which would
        // drop the rail width set at runtime — carry it onto the new document.
        if (incoming) {
          var railW = document.documentElement.style.getPropertyValue('--rail-w');
          if (railW) incoming.documentElement.style.setProperty('--rail-w', railW);
        }
      });

      document.addEventListener('astro:after-swap', function () {
        if (canReveal()) {
          // Whatever lands in the first screenful of the incoming page should
          // simply be there. Only content further down animates in as it is
          // scrolled to — otherwise every click reads as the page fading in
          // twice, once in the view-transition cross-fade and again in the
          // reveal.
          //
          // This has to happen here, synchronously: the browser snapshots the
          // new state once the swap callback returns, so marking them in the
          // observer's first batch would put an empty page in that snapshot.
          // Measuring against the document rather than the viewport keeps it
          // independent of when the scroll position gets reset.
          var fold = window.innerHeight;
          document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach(function (el) {
            var node = el as HTMLElement;
            if (node.getBoundingClientRect().top + window.scrollY >= fold) return;
            node.style.transition = 'none';
            node.classList.add('is-visible');
            requestAnimationFrame(function () {
              node.style.transition = '';
            });
          });
        }
        observeReveals();
      });

      observeReveals();
    </script>
  </body>
</html>
