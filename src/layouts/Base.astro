---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteName = 'WU Yandong';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var mode = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
        var resolved = mode === 'light' || mode === 'dark'
          ? mode
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', resolved);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased text-slate-700 dark:text-slate-200">
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* 文章正文排版（博客与项目详情共用） */
  .blog-prose {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #334155;
  }
  [data-theme='dark'] .blog-prose {
    color: #cbd5e1;
  }
  .blog-prose h1,
  .blog-prose h2,
  .blog-prose h3,
  .blog-prose h4 {
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
    scroll-margin-top: 5rem;
  }
  [data-theme='dark'] .blog-prose h1,
  [data-theme='dark'] .blog-prose h2,
  [data-theme='dark'] .blog-prose h3,
  [data-theme='dark'] .blog-prose h4 {
    color: #f1f5f9;
  }
  .blog-prose h1 { font-size: 1.875rem; margin: 2.5rem 0 1rem; }
  .blog-prose h2 { font-size: 1.5rem; margin: 2.25rem 0 1rem; }
  .blog-prose h3 { font-size: 1.25rem; margin: 1.75rem 0 0.75rem; }
  .blog-prose h4 { font-size: 1.125rem; margin: 1.5rem 0 0.75rem; }
  .blog-prose p { margin: 1rem 0; }
  .blog-prose a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  [data-theme='dark'] .blog-prose a { color: #7dd3fc; }
  .blog-prose ul,
  .blog-prose ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .blog-prose ul { list-style: disc; }
  .blog-prose ol { list-style: decimal; }
  .blog-prose li { margin: 0.375rem 0; }
  .blog-prose li > ul,
  .blog-prose li > ol { margin: 0.375rem 0; }
  .blog-prose blockquote {
    border-left: 4px solid var(--color-brand);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: #64748b;
    font-style: italic;
  }
  [data-theme='dark'] .blog-prose blockquote { color: #94a3b8; }
  .blog-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: #f1f5f9;
    color: #be185d;
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
  }
  [data-theme='dark'] .blog-prose code { background: #334155; color: #fda4af; }
  .blog-prose pre {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.875rem;
  }
  .blog-prose pre code {
    background: transparent;
    color: inherit;
    padding: 0;
    font-size: 0.9em;
  }
  .blog-prose img {
    border-radius: 0.75rem;
    margin: 1.25rem 0;
    max-width: 100%;
  }
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.95rem;
  }
  .blog-prose th,
  .blog-prose td {
    border: 1px solid #cbd5e1;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  [data-theme='dark'] .blog-prose th,
  [data-theme='dark'] .blog-prose td { border-color: #475569; }
  .blog-prose th { background: #f1f5f9; }
  [data-theme='dark'] .blog-prose th { background: #334155; }
  .blog-prose hr {
    border: 0;
    border-top: 1px solid #e2e8f0;
    margin: 2rem 0;
  }
  [data-theme='dark'] .blog-prose hr { border-color: #334155; }
  .blog-prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem 0;
  }
</style>
