---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  title="WU Yandong — Robotics / Embedded Systems / Control Systems"
  description="The Hong Kong Polytechnic University · Electrical Engineering. Robotics, embedded systems, and control systems — the personal site of WU Yandong."
>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[340px_minmax(0,1fr)] lg:items-start">
      <!-- Top-left profile block -->
      <aside>
        <Hero />
      </aside>

      <!-- Featured projects + contact -->
      <div class="flex flex-col gap-10">
        <section>
          <div class="flex items-end justify-between gap-4">
            <h2 class="font-display text-2xl text-ink">Featured Projects</h2>
            <a href="/projects" class="crt-text text-xl text-retro-blue hover:underline">View all →</a>
          </div>
          <div class="rainbow-bar mt-3" aria-hidden="true"></div>
          {projects.length > 0 ? (
            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
              {projects.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          ) : (
            <p class="mt-6 text-sm text-ink-muted">No projects yet.</p>
          )}
        </section>

        <section class="retro-card retro-card--blue p-8 text-center">
          <h2 class="font-display text-2xl text-ink">Get in Touch</h2>
          <p class="mt-2 text-ink-muted">
            I'm open to collaboration and new ideas — feel free to reach out.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a href="mailto:dongdong7559@gmail.com" class="retro-btn retro-btn--primary">Send Email</a>
            <a
              href="https://github.com/W-dongdong"
              target="_blank"
              rel="noopener noreferrer"
              class="retro-btn"
            >
              GitHub
            </a>
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>
