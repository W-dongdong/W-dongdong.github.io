---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page Not Found" description="The page you are looking for does not exist or has been moved.">
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center">
    <div class="card px-10 py-12">
      <p class="crt-text text-5xl leading-none text-ink-muted">404</p>
      <div class="rule mx-auto mt-5 max-w-32" aria-hidden="true"></div>
      <h1 class="mt-5 font-display text-xl font-bold text-ink">This page wandered off</h1>
      <p class="mt-2 text-ink-muted">
        The page you are looking for does not exist, or it has moved somewhere else.
      </p>
      <a href="/" class="btn btn--primary mt-6">Take me home</a>
    </div>
  </section>
</Base>
