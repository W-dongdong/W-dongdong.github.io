---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page Not Found" description="The page you are looking for does not exist or has been moved.">
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center">
    <div class="retro-card retro-card--red scanlines px-10 py-12">
      <p class="crt-text text-6xl text-retro-red">404</p>
      <div class="rainbow-bar mt-4" aria-hidden="true"></div>
      <h1 class="mt-5 font-display text-2xl text-ink">Page Not Found</h1>
      <p class="mt-2 text-ink-muted">The page you are looking for does not exist or has been moved.</p>
      <a href="/" class="retro-btn retro-btn--primary mt-6">Back to Home</a>
    </div>
  </section>
</Base>
