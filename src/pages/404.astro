---
import Base from '../layouts/Base.astro';
---

<Base title="404 — 页面未找到" description="你访问的页面不存在或已被移动。">
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center">
    <p class="text-6xl font-extrabold text-brand dark:text-sky-300">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900 dark:text-white">页面未找到</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300">你访问的页面不存在或已被移动。</p>
    <a
      href="/"
      class="mt-6 rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-600"
    >
      返回首页
    </a>
  </section>
</Base>
