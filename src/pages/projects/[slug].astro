---
import Base from '../../layouts/Base.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const dateStr = project.data.date.toISOString().slice(0, 10);
---

<Base
  title={`${project.data.title} — Project`}
  description={project.data.summary ?? project.data.title}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="border-b-2 border-ink pb-8">
      <div class="crt-text flex flex-wrap items-center gap-3 text-lg text-ink-muted">
        <time datetime={dateStr}>{dateStr}</time>
        {project.data.status && (
          <span class="crt-tag text-retro-red">{project.data.status}</span>
        )}
      </div>
      <h1 class="mt-4 font-display text-3xl text-ink sm:text-4xl">
        {project.data.title}
      </h1>
      {project.data.summary && (
        <p class="mt-3 text-lg text-ink-muted">{project.data.summary}</p>
      )}
      {project.data.tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {project.data.tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}
      {(project.data.repo || project.data.demo) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {project.data.repo && (
            <a
              href={project.data.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="retro-btn retro-btn--primary"
            >
              GitHub Repository
            </a>
          )}
          {project.data.demo && (
            <a
              href={project.data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="retro-btn"
            >
              Live Demo
            </a>
          )}
        </div>
      )}
    </header>

    <div class="blog-prose mt-8">
      <Content />
    </div>
  </article>
</Base>
