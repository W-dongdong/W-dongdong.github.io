---
import Base from '../../layouts/Base.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const dateStr = project.data.date.toISOString().slice(0, 10);
---

<Base
  title={`${project.data.title} — Project`}
  description={project.data.summary ?? project.data.title}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header data-reveal>
      <a href="/projects" class="crt-text text-sm text-retro-blue hover:underline">
        ← All projects
      </a>

      <h1 class="mt-5 font-display text-2xl font-bold text-ink sm:text-3xl">
        {project.data.title}
      </h1>

      {project.data.summary && (
        <p class="mt-3 text-lg text-ink-muted">{project.data.summary}</p>
      )}

      <div class="crt-text mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-muted">
        <time datetime={dateStr}>{dateStr}</time>
        {project.data.status && <span>{project.data.status}</span>}
      </div>

      {project.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {project.data.tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}

      {(project.data.repo || project.data.demo) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {project.data.repo && (
            <a
              href={project.data.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary"
            >
              GitHub Repository
            </a>
          )}
          {project.data.demo && (
            <a
              href={project.data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
            >
              Live Demo
            </a>
          )}
        </div>
      )}

      <div class="rule mt-8" aria-hidden="true"></div>
    </header>

    <div class="blog-prose mt-8">
      <Content />
    </div>
  </article>
</Base>
