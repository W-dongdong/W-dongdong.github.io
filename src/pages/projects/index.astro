---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="项目 — WU Yandong"
  description="WU Yandong 的项目：机器人、嵌入式与控制系统的实践作品。"
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      项目
    </h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
      机器人、嵌入式与控制系统的实践作品。
    </p>

    {projects.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">暂无项目。</p>
    )}
  </section>
</Base>
