---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="博客 — WU Yandong"
  description="WU Yandong 的博客：机器人、嵌入式与控制系统的学习笔记与技术文章。"
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
      博客
    </h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
      机器人、嵌入式与控制系统的学习笔记。
    </p>

    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="按语言筛选">
      <button type="button" data-lang-filter="all" class="lang-filter-btn">全部</button>
      <button type="button" data-lang-filter="en" class="lang-filter-btn">English</button>
      <button type="button" data-lang-filter="zh" class="lang-filter-btn">中文</button>
    </div>

    {posts.length > 0 ? (
      <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <li data-lang={p.data.lang} class="contents">
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">暂无文章。</p>
    )}
  </section>
</Base>

<style is:global>
  .lang-filter-btn {
    border-radius: 0.5rem;
    border: 1px solid #cbd5e1;
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #475569;
    background: #ffffff;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  [data-theme='dark'] .lang-filter-btn {
    border-color: #475569;
    color: #cbd5e1;
    background: #1e293b;
  }
  .lang-filter-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
  .lang-filter-btn[aria-pressed='true'] {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #ffffff;
  }
  [data-theme='dark'] .lang-filter-btn[aria-pressed='true'] {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #ffffff;
  }
</style>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('[data-lang-filter]');
    var cards = document.querySelectorAll('[data-lang]');
    if (!buttons.length || !cards.length) return;

    var active = 'all';

    function apply() {
      cards.forEach(function (card) {
        var show = active === 'all' || card.getAttribute('data-lang') === active;
        card.style.display = show ? '' : 'none';
      });
      buttons.forEach(function (btn) {
        var isActive = btn.getAttribute('data-lang-filter') === active;
        btn.setAttribute('aria-pressed', String(isActive));
      });
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        active = btn.getAttribute('data-lang-filter');
        apply();
      });
    });

    apply();
  })();
</script>
