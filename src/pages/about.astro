---
import Base from '../layouts/Base.astro';

const skills = [
  'C / C++ / Python',
  'Bare-metal STM32',
  'CAN / I2C / UART',
  'PID / Cascade PID / LQR',
  'ROS2 / Linux',
  'FreeRTOS',
];

const interests = [
  'Robotics',
  'Embedded Systems',
  'Control Systems',
];
---

<Base
  title="About — WU Yandong"
  description="WU Yandong, an Electrical Engineering undergraduate at The Hong Kong Polytechnic University, focused on robotics, embedded systems, and control systems."
>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <header>
      <h1 class="font-display text-3xl text-ink sm:text-4xl">About Me</h1>
      <div class="rainbow-bar mt-3" aria-hidden="true"></div>
      <p class="mt-6 text-lg leading-relaxed text-ink-muted">
        I'm WU Yandong, an Electrical Engineering undergraduate at The Hong Kong Polytechnic University.
        My work centers on robotics, embedded systems, and control systems — from low-level drivers to
        high-level control, I enjoy turning theoretical algorithms into working hardware.
      </p>
    </header>

    <h2 class="mt-12 font-display text-2xl text-ink">Education</h2>
    <ol class="mt-6 space-y-6 border-l-2 border-ink pl-6">
      <li class="relative">
        <span class="absolute -left-[31px] top-1.5 h-3 w-3 border-2 border-ink bg-cream"></span>
        <div class="retro-card retro-card--blue p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-display text-base text-ink">The Hong Kong Polytechnic University · BEng in Electrical Engineering</h3>
            <time class="crt-text text-lg text-ink-muted">2024 – 2028</time>
          </div>
          <ul class="mt-2 space-y-1 text-sm text-ink-muted">
            <li>GPA 3.54 / 4.3 · Year 3 Undergraduate</li>
            <li>Minor: Electronic System &amp; IoT</li>
          </ul>
        </div>
      </li>
    </ol>

    <h2 class="mt-12 font-display text-2xl text-ink">Credentials</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="retro-card retro-card--green p-5">
        <h3 class="font-display text-base text-ink">Minor</h3>
        <p class="mt-1 text-sm text-ink-muted">Electronic System &amp; IoT</p>
      </div>
      <div class="retro-card retro-card--amber p-5">
        <h3 class="font-display text-base text-ink">Membership</h3>
        <p class="mt-1 text-sm text-ink-muted">Student Member of the HKIE (Hong Kong Institution of Engineers)</p>
      </div>
    </div>

    <h2 class="mt-12 font-display text-2xl text-ink">Skills</h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <li class="crt-tag">{skill}</li>
      ))}
    </ul>

    <h2 class="mt-12 font-display text-2xl text-ink">Research &amp; Interest Directions</h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {interests.map((interest) => (
        <li class="crt-tag">{interest}</li>
      ))}
    </ul>
  </section>
</Base>
