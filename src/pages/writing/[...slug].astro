---
import Base from '../../layouts/Base.astro';
import TagBadge from '../../components/TagBadge.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import SeriesPager from '../../components/SeriesPager.astro';
import { getCollection, render } from 'astro:content';
import { isGroup, isSeriesHome, seriesContents, seriesForPath, seriesNeighbours } from '../../lib/series';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toISOString().slice(0, 10);

// Pages that belong to a series get the rail and the pager; everything else
// stays a plain centred article.
const series = seriesForPath(Astro.url.pathname);
const onHome = series ? isSeriesHome(series, Astro.url.pathname) : false;
const { prev, next } = series ? seriesNeighbours(series, Astro.url.pathname) : {};
---

<Base
  title={`${post.data.title} — Writing`}
  description={post.data.description ?? post.data.title}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    {series && (
      <details class="series-disclosure mb-8 lg:hidden">
        <summary class="crt-text text-xs tracking-[0.14em] text-ink-muted uppercase">
          {series.title} 目录
        </summary>
        <div class="mt-4 border-t border-line pt-4">
          <SeriesNav series={series} pathname={Astro.url.pathname} idPrefix="mobile" />
        </div>
      </details>
    )}

    <div class={series ? 'series-layout' : ''}>
      {series && (
        <aside class="series-rail hidden lg:block">
          <div class="sticky top-24">
            <SeriesNav series={series} pathname={Astro.url.pathname} idPrefix="desktop" />
          </div>

          <div
            class="series-rail__handle"
            role="separator"
            aria-orientation="vertical"
            aria-label="拖动调整目录宽度"
            tabindex="0"
          >
          </div>
        </aside>
      )}

      <article class={series ? 'max-w-3xl' : 'mx-auto max-w-3xl'}>
        <header data-reveal>
          <a href="/writing" class="crt-text text-sm text-retro-blue hover:underline">
            ← All writing
          </a>

          <h1 class="mt-5 font-display text-2xl font-bold text-ink sm:text-3xl">
            {post.data.title}
          </h1>

          {post.data.description && (
            <p class="mt-3 text-lg text-ink-muted">{post.data.description}</p>
          )}

          <div class="crt-text mt-5 text-xs text-ink-muted">
            <time datetime={dateStr}>{dateStr}</time>
          </div>

          {post.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <TagBadge tag={tag} />
              ))}
            </div>
          )}

          <div class="rule mt-8" aria-hidden="true"></div>
        </header>

        <div class="blog-prose mt-8">
          <Content />
        </div>

        {onHome && series && (
          <div class="mt-12">
            <p class="eyebrow">本系列</p>
            <ul class="mt-6 space-y-6">
              {seriesContents(series).map((node) =>
                isGroup(node) ? (
                  <li>
                    <p class="crt-text text-xs tracking-[0.14em] text-ink-muted uppercase">
                      {node.title}
                    </p>
                    <ul class="mt-3 space-y-4 border-l border-line pl-5">
                      {node.pages.map((page) => (
                        <li>
                          <a href={page.href} class="group block">
                            <span class="font-display font-bold text-ink transition-colors group-hover:text-retro-blue">
                              {page.title}
                            </span>
                            {page.blurb && (
                              <span class="mt-0.5 block text-sm leading-relaxed text-ink-muted">
                                {page.blurb}
                              </span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li>
                    <a href={node.href} class="group block">
                      <span class="font-display font-bold text-ink transition-colors group-hover:text-retro-blue">
                        {node.title}
                      </span>
                      {node.blurb && (
                        <span class="mt-0.5 block text-sm leading-relaxed text-ink-muted">
                          {node.blurb}
                        </span>
                      )}
                    </a>
                  </li>
                ),
              )}
            </ul>
          </div>
        )}

        {series && (prev || next) && <SeriesPager prevHref={prev?.href} nextHref={next?.href} />}
      </article>
    </div>
  </div>
</Base>

<script>
  // Drag the rail to set its width. The width lives on <html> as --rail-w so
  // the layout rule can read it, and is remembered across pages.
  const RAIL_MIN = 150;
  const RAIL_MAX = 460;
  const RAIL_FALLBACK = 208;
  const RAIL_KEY = 'rail-w';

  function initRailDrag() {
    const handle = document.querySelector<HTMLElement>('.series-rail__handle');
    const layout = document.querySelector<HTMLElement>('.series-layout');
    if (!handle || !layout) return;

    function setWidth(px: number) {
      const width = Math.round(Math.min(RAIL_MAX, Math.max(RAIL_MIN, px)));
      document.documentElement.style.setProperty('--rail-w', `${width}px`);
      return width;
    }

    function storedWidth() {
      const set = parseFloat(getComputedStyle(layout!).getPropertyValue('--rail-w'));
      return Number.isFinite(set) ? set : RAIL_FALLBACK;
    }

    function remember(px: number) {
      try {
        localStorage.setItem(RAIL_KEY, String(px));
      } catch {
        /* private mode, nothing to do */
      }
    }

    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      event.preventDefault();

      const origin = layout!.getBoundingClientRect().left;
      let width = storedWidth();

      try {
        handle.setPointerCapture(event.pointerId);
      } catch {
        /* capture is a nicety — the listeners below still track the drag */
      }
      handle.classList.add('is-dragging');
      document.body.style.userSelect = 'none';

      const onMove = (move: PointerEvent) => {
        width = setWidth(move.clientX - origin);
      };
      const onEnd = () => {
        handle.classList.remove('is-dragging');
        document.body.style.userSelect = '';
        handle.removeEventListener('pointermove', onMove);
        handle.removeEventListener('pointerup', onEnd);
        handle.removeEventListener('pointercancel', onEnd);
        remember(width);
      };

      handle.addEventListener('pointermove', onMove);
      handle.addEventListener('pointerup', onEnd);
      handle.addEventListener('pointercancel', onEnd);
    });

    // Keyboard equivalent, so the separator is usable without a pointer.
    handle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      remember(setWidth(storedWidth() + (event.key === 'ArrowRight' ? 16 : -16)));
    });
  }

  document.addEventListener('astro:page-load', initRailDrag);
</script>
