---
// Folder-based VHS background-music player.
//
// Every audio file dropped into `src/assets/music/` is picked up
// automatically at build time, sorted by filename, played in order and
// looped. Name files `01-...`, `02-...` to control the order.
//
// Controls:
//   * Play / pause
//   * Playlist button — pick any track directly
//   * Playback mode button — cycles Sequential → Shuffle → Repeat all (icons)
//
// Visitor behaviour:
//   * Tries to autoplay on load; browsers block unmuted autoplay, so it
//     falls back to starting on the first click / keypress / tap.
//   * A visitor who pauses is remembered (localStorage) and is never
//     started again automatically.
//   * Track index + playback position survive page navigation in a tab.
//
// If the folder has no audio yet, the player renders nothing at all.
const modules = import.meta.glob('/src/assets/music/*.{mp3,m4a,ogg,opus,wav,flac,aac}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;

const tracks = Object.keys(modules)
  .sort()
  .map((path) => {
    const file = path.split('/').pop() ?? path;
    return {
      src: modules[path],
      title: file.replace(/\.[^.]+$/, '').replace(/^\d+[\s._-]+/, '') || file,
    };
  });
---

{
  tracks.length > 0 && (
    <div id="bgm-player" class="bgm-player" data-playlist={JSON.stringify(tracks)} data-mode="order">
      <audio id="bgm-audio" preload="auto" />

      <div id="bgm-list-panel" class="bgm-list-panel" hidden>
        <p class="bgm-list-head">PLAYLIST</p>
        <ul class="bgm-list">
          {tracks.map((track, i) => (
            <li>
              <button type="button" class="bgm-item" data-index={i}>
                <span class="bgm-item-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="bgm-item-title">{track.title}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="bgm-bar">
        <button
          id="bgm-toggle"
          type="button"
          class="bgm-btn"
          aria-label="Play background music"
          aria-pressed="false"
          title="Play / pause"
        >
          <svg class="bgm-pi bgm-pi-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="6 4 20 12 6 20" />
          </svg>
          <svg class="bgm-pi bgm-pi-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16" />
            <rect x="14" y="4" width="4" height="16" />
          </svg>
        </button>

        <span id="bgm-track" class="bgm-track">{tracks[0].title}</span>

        <button
          id="bgm-list-toggle"
          type="button"
          class="bgm-btn"
          aria-label="Choose a track"
          aria-expanded="false"
          title="Choose a track"
        >
          <svg class="bgm-bi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
        </button>

        <button
          id="bgm-mode"
          type="button"
          class="bgm-btn"
          aria-label="Playback mode: Play in order — click to change"
          title="Playback mode"
        >
          <svg class="bgm-mi bgm-mi-order" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
          <svg class="bgm-mi bgm-mi-shuffle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 3 21 3 21 8"></polyline>
            <line x1="4" y1="20" x2="21" y2="3"></line>
            <polyline points="21 16 21 21 16 21"></polyline>
            <line x1="15" y1="15" x2="21" y2="21"></line>
            <line x1="4" y1="4" x2="9" y2="9"></line>
          </svg>
          <svg class="bgm-mi bgm-mi-loop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="17 1 21 5 17 9"></polyline>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
            <polyline points="7 23 3 19 7 15"></polyline>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
          </svg>
        </button>
      </div>
    </div>
  )
}

<style>
  .bgm-player {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .bgm-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    max-width: min(88vw, 26rem);
    padding: 0.3rem 0.35rem;
    border: 2px solid var(--fg);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--blue);
    transition: box-shadow 0.12s ease;
  }
  .bgm-player[data-playing='true'] .bgm-bar {
    box-shadow: 4px 4px 0 var(--red);
  }

  .bgm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--fg);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .bgm-btn:hover,
  .bgm-btn[aria-expanded='true'] {
    background: var(--blue);
    color: var(--bg);
  }

  .bgm-pi,
  .bgm-mi,
  .bgm-bi {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* play / pause icon swap */
  .bgm-pi { display: none; }
  .bgm-player:not([data-playing='true']) .bgm-pi-play { display: block; }
  .bgm-player[data-playing='true'] .bgm-pi-pause { display: block; }

  /* playback-mode icon swap */
  .bgm-mi { display: none; }
  .bgm-player[data-mode='order'] .bgm-mi-order { display: block; }
  .bgm-player[data-mode='shuffle'] .bgm-mi-shuffle { display: block; }
  .bgm-player[data-mode='loop'] .bgm-mi-loop { display: block; }

  .bgm-track {
    font-family: var(--font-crt);
    font-size: 1rem;
    letter-spacing: 0.05em;
    max-width: 13rem;
    padding: 0 0.15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bgm-list-panel {
    width: min(88vw, 26rem);
    max-height: 16rem;
    overflow-y: auto;
    border: 2px solid var(--fg);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--amber);
  }
  .bgm-list-panel[hidden] { display: none; }

  .bgm-list-head {
    margin: 0;
    padding: 0.35rem 0.6rem;
    border-bottom: 2px solid var(--fg);
    font-family: var(--font-crt);
    font-size: 0.95rem;
    letter-spacing: 0.14em;
  }

  .bgm-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bgm-item {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    padding: 0.35rem 0.6rem;
    border: 0;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-crt);
    font-size: 1rem;
    text-align: left;
    cursor: pointer;
  }
  .bgm-item:hover { background: var(--bg); }
  .bgm-item.is-active {
    background: var(--blue);
    color: var(--bg);
  }

  .bgm-item-num {
    flex: none;
    opacity: 0.7;
  }
  .bgm-item-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('bgm-player');
    if (!root) return;
    var audio = document.getElementById('bgm-audio');
    var playBtn = document.getElementById('bgm-toggle');
    var label = document.getElementById('bgm-track');
    var listToggle = document.getElementById('bgm-list-toggle');
    var panel = document.getElementById('bgm-list-panel');
    var modeBtn = document.getElementById('bgm-mode');
    var items = Array.prototype.slice.call(root.querySelectorAll('.bgm-item'));
    if (!audio || !playBtn || !listToggle || !panel || !modeBtn) return;

    var tracks = [];
    try {
      tracks = JSON.parse(root.getAttribute('data-playlist') || '[]');
    } catch (e) {
      tracks = [];
    }
    if (!tracks.length) return;

    var DISABLED = 'bgm-disabled'; // localStorage — visitor turned the music off
    var MODE = 'bgm-mode'; // localStorage — playback mode
    var INDEX = 'bgm-index'; // sessionStorage — current track
    var TIME = 'bgm-time'; // sessionStorage — position in the current track

    var MODES = ['order', 'shuffle', 'loop'];
    var MODE_LABEL = { order: 'Play in order', shuffle: 'Shuffle', loop: 'Repeat all' };

    function get(store, key) {
      try {
        return store.getItem(key);
      } catch (e) {
        return null;
      }
    }
    function set(store, key, value) {
      try {
        store.setItem(key, value);
      } catch (e) {}
    }

    var mode = get(localStorage, MODE);
    if (MODES.indexOf(mode) === -1) mode = 'order';

    var index = parseInt(get(sessionStorage, INDEX) || '0', 10);
    if (isNaN(index) || index < 0 || index >= tracks.length) index = 0;

    function paintPlaying(isPlaying) {
      root.setAttribute('data-playing', isPlaying ? 'true' : 'false');
      playBtn.setAttribute('aria-pressed', String(isPlaying));
      playBtn.setAttribute(
        'aria-label',
        (isPlaying ? 'Pause' : 'Play') + ' background music'
      );
    }

    function paintMode() {
      root.setAttribute('data-mode', mode);
      var text = 'Playback mode: ' + MODE_LABEL[mode] + ' — click to change';
      modeBtn.setAttribute('aria-label', text);
      modeBtn.setAttribute('title', text);
    }

    function markActive() {
      items.forEach(function (item) {
        var i = parseInt(item.getAttribute('data-index'), 10);
        item.classList.toggle('is-active', i === index);
      });
    }

    function show(i) {
      index = i;
      audio.src = tracks[i].src;
      if (label) label.textContent = tracks[i].title;
      set(sessionStorage, INDEX, String(i));
      markActive();
    }

    // Restore the position within the current track once its metadata is ready.
    var pendingTime = parseFloat(get(sessionStorage, TIME) || '0');
    audio.addEventListener('loadedmetadata', function () {
      if (!isNaN(pendingTime) && pendingTime > 0 && pendingTime < audio.duration) {
        try {
          audio.currentTime = pendingTime;
        } catch (e) {}
      }
      pendingTime = 0;
    });

    paintMode();
    show(index);

    function attempt() {
      var promise = audio.play();
      if (promise && typeof promise.catch === 'function') {
        promise.catch(function () {
          paintPlaying(false);
          armFirstGesture();
        });
      }
    }

    var armed = false;
    function armFirstGesture() {
      if (armed) return;
      armed = true;
      var start = function () {
        document.removeEventListener('click', start, true);
        document.removeEventListener('keydown', start, true);
        document.removeEventListener('touchstart', start, true);
        if (get(localStorage, DISABLED) !== '1' && audio.paused) attempt();
      };
      document.addEventListener('click', start, true);
      document.addEventListener('keydown', start, true);
      document.addEventListener('touchstart', start, true);
    }

    if (get(localStorage, DISABLED) === '1') {
      paintPlaying(false);
    } else {
      attempt();
    }

    // Which track comes next, based on the current playback mode.
    function nextIndex() {
      var n = tracks.length;
      if (mode === 'shuffle') {
        if (n === 1) return 0;
        var r;
        do {
          r = Math.floor(Math.random() * n);
        } while (r === index);
        return r;
      }
      if (mode === 'loop') return (index + 1) % n;
      return index + 1; // 'order' — may run past the end, handled below
    }

    playBtn.addEventListener('click', function (event) {
      event.stopPropagation();
      if (audio.paused) {
        set(localStorage, DISABLED, '0');
        attempt();
      } else {
        audio.pause();
        set(localStorage, DISABLED, '1');
      }
    });

    modeBtn.addEventListener('click', function (event) {
      event.stopPropagation();
      mode = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
      set(localStorage, MODE, mode);
      paintMode();
    });

    listToggle.addEventListener('click', function (event) {
      event.stopPropagation();
      var open = panel.hasAttribute('hidden');
      if (open) {
        panel.removeAttribute('hidden');
      } else {
        panel.setAttribute('hidden', '');
      }
      listToggle.setAttribute('aria-expanded', String(open));
    });

    items.forEach(function (item) {
      item.addEventListener('click', function (event) {
        event.stopPropagation();
        var i = parseInt(item.getAttribute('data-index'), 10);
        if (isNaN(i)) return;
        pendingTime = 0;
        set(sessionStorage, TIME, '0');
        set(localStorage, DISABLED, '0');
        show(i);
        attempt();
        panel.setAttribute('hidden', '');
        listToggle.setAttribute('aria-expanded', 'false');
      });
    });

    // Clicking elsewhere closes the playlist.
    document.addEventListener('click', function () {
      if (!panel.hasAttribute('hidden')) {
        panel.setAttribute('hidden', '');
        listToggle.setAttribute('aria-expanded', 'false');
      }
    });

    audio.addEventListener('play', function () {
      paintPlaying(true);
    });
    audio.addEventListener('pause', function () {
      paintPlaying(false);
    });
    audio.addEventListener('timeupdate', function () {
      set(sessionStorage, TIME, String(audio.currentTime));
    });

    // Track finished → advance according to the current playback mode.
    audio.addEventListener('ended', function () {
      var next = nextIndex();
      pendingTime = 0;
      set(sessionStorage, TIME, '0');
      if (next >= tracks.length) {
        // 'order' mode reached the end of the list: back to the top, paused.
        show(0);
        paintPlaying(false);
        return;
      }
      show(next);
      if (get(localStorage, DISABLED) !== '1') attempt();
    });

    paintPlaying(!audio.paused);
  })();
</script>
