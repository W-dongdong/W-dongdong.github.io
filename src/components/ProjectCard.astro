---
import TagBadge from './TagBadge.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary?: string;
      date: Date;
      tags: string[];
      status?: string;
    };
  };
}

const { project } = Astro.props;
const dateStr = project.data.date.toISOString().slice(0, 10);
---

<a href={`/projects/${project.id}`} class="card group flex h-full flex-col overflow-hidden">
  <div class="h-0.5 w-full bg-retro-blue" aria-hidden="true"></div>

  <div class="flex flex-1 flex-col p-5">
    <div class="crt-text flex items-center justify-between gap-2 text-sm leading-none text-ink-muted">
      <time datetime={dateStr}>{dateStr}</time>
      {project.data.status && <span>{project.data.status}</span>}
    </div>

    <h3 class="mt-2.5 font-display text-base leading-snug text-ink transition-colors group-hover:text-retro-blue">
      {project.data.title}
    </h3>

    {project.data.summary && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">{project.data.summary}</p>
    )}

    {project.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {project.data.tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )}
  </div>
</a>
