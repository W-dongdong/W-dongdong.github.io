---
import TagBadge from './TagBadge.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary?: string;
      date: Date;
      tags: string[];
      status?: string;
    };
  };
}

const { project } = Astro.props;
const dateStr = project.data.date.toISOString().slice(0, 10);
---

<a
  href={`/projects/${project.id}`}
  class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand hover:shadow-md dark:border-slate-700 dark:bg-[#1e293b] dark:hover:border-sky-400"
>
  <div class="flex items-center justify-between gap-2">
    <time datetime={dateStr} class="text-xs text-slate-400 dark:text-slate-500">{dateStr}</time>
    {project.data.status && (
      <span class="text-xs font-medium text-brand dark:text-sky-300">{project.data.status}</span>
    )}
  </div>
  <h3 class="mt-2 text-lg font-semibold text-slate-900 transition-colors group-hover:text-brand dark:text-white dark:group-hover:text-sky-300">
    {project.data.title}
  </h3>
  {project.data.summary && (
    <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-300">{project.data.summary}</p>
  )}
  {project.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {project.data.tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>
  )}
</a>
