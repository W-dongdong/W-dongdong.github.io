---
import TagBadge from './TagBadge.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary?: string;
      date: Date;
      tags: string[];
      status?: string;
    };
  };
}

const { project } = Astro.props;
const dateStr = project.data.date.toISOString().slice(0, 10);

// Deterministic retro accent per project (stable across builds).
const accents = ['red', 'blue', 'amber', 'green'] as const;
let hash = 0;
for (const ch of project.id) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const accent = accents[hash % accents.length];
const accentVar = `var(--${accent})`;
---

<a
  href={`/projects/${project.id}`}
  class={`retro-card retro-card--${accent} group flex h-full flex-col overflow-hidden`}
>
  <div class="h-1.5 w-full" style={`background: ${accentVar}`} aria-hidden="true"></div>

  <div class="flex flex-1 flex-col p-5">
    <div class="crt-text flex items-center justify-between gap-2 text-lg leading-none text-ink-muted">
      <time datetime={dateStr}>{dateStr}</time>
      {project.data.status && <span>{project.data.status}</span>}
    </div>

    <h3 class="retro-card-title mt-2 font-display text-lg leading-snug text-ink transition-colors">
      {project.data.title}
    </h3>

    {project.data.summary && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">{project.data.summary}</p>
    )}

    {project.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {project.data.tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )}
  </div>
</a>
