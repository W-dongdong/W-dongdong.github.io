---
import TagBadge from './TagBadge.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary?: string;
      date: Date;
      tags: string[];
      status?: string;
    };
  };
  /** 'grid' — compact tile for a multi-column grid. 'row' — wide list entry. */
  layout?: 'grid' | 'row';
}

const { project, layout = 'grid' } = Astro.props;
const dateStr = project.data.date.toISOString().slice(0, 10);
---

<a
  href={`/projects/${project.id}`}
  class="card group flex h-full flex-col overflow-hidden"
>
  <div class="h-0.5 w-full flex-none bg-retro-blue" aria-hidden="true"></div>

  {layout === 'grid' ? (
    <div class="flex flex-1 flex-col p-5">
      <div class="crt-text flex items-center justify-between gap-2 text-xs leading-none text-ink-muted">
        <time datetime={dateStr}>{dateStr}</time>
        {project.data.status && <span>{project.data.status}</span>}
      </div>

      <h3 class="mt-2.5 font-display text-base leading-snug text-ink transition-colors group-hover:text-retro-blue">
        {project.data.title}
      </h3>

      {project.data.summary && (
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">{project.data.summary}</p>
      )}

      {project.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {project.data.tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="flex flex-1 flex-col gap-3 p-5 sm:flex-row sm:gap-6">
      <div class="crt-text flex flex-none items-baseline gap-3 text-xs leading-none text-ink-muted sm:w-28 sm:flex-col sm:items-start sm:gap-1.5">
        <time datetime={dateStr}>{dateStr}</time>
        {project.data.status && <span>{project.data.status}</span>}
      </div>

      <div class="flex-1">
        <h3 class="font-display text-base leading-snug text-ink transition-colors group-hover:text-retro-blue">
          {project.data.title}
        </h3>

        {project.data.summary && (
          <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{project.data.summary}</p>
        )}

        {project.data.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {project.data.tags.map((tag) => (
              <TagBadge tag={tag} />
            ))}
          </div>
        )}
      </div>

      <span
        class="hidden flex-none text-ink-muted transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-retro-blue sm:block"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="h-5 w-5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </span>
    </div>
  )}
</a>
