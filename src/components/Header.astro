---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 w-full border-b border-line bg-cream/90 backdrop-blur">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center gap-3">
      <span class="font-display text-base tracking-tight text-ink sm:text-lg">WU Yandong</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <ul class="hidden items-center gap-6 md:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'crt-text block border-b text-base leading-tight transition-colors',
                isActive(item.href)
                  ? 'border-retro-blue text-retro-blue'
                  : 'border-transparent text-ink-muted hover:border-line-strong hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center border border-line p-2 text-ink transition-colors hover:bg-cream-2 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.6"
          stroke="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
          />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line md:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'crt-text block px-2 py-1.5 text-base transition-colors',
              isActive(item.href)
                ? 'text-retro-blue'
                : 'text-ink-muted hover:bg-cream-2 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  // Mobile menu: delegated, so it also works on the header re-rendered by
  // ClientRouter on navigation.
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var btn = target.closest('#menu-toggle');
    if (!btn) return;
    var menu = document.getElementById('mobile-menu');
    if (!menu) return;
    menu.classList.toggle('hidden');
    var open = !menu.classList.contains('hidden');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
