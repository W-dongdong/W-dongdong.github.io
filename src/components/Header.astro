---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 w-full border-b-2 border-ink bg-cream/95 backdrop-blur">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6"
    aria-label="Main navigation"
  >
    <a href="/" class="group flex items-center gap-3">
      <span class="osd-badge text-retro-red">▶ PLAY</span>
      <span class="font-display text-lg tracking-tight text-ink sm:text-xl">WU Yandong</span>
    </a>

    <div class="flex items-center gap-3">
      <span class="osd-badge hidden text-retro-red lg:inline-flex">
        <span class="text-retro-red">●</span> REC
      </span>
      <span id="osd-clock" class="crt-text hidden text-2xl leading-none text-ink sm:inline-block">00:00:00</span>

      <ul class="hidden items-center gap-1 md:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'crt-text block px-3 py-1.5 text-xl leading-none transition-colors',
                isActive(item.href)
                  ? 'border border-ink bg-retro-blue text-cream'
                  : 'text-ink-muted hover:bg-cream-2 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center border border-ink p-2 text-ink transition-colors hover:bg-cream-2 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="h-6 w-6"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
          />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t-2 border-ink md:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'crt-text block px-3 py-2 text-xl leading-none transition-colors',
              isActive(item.href)
                ? 'border border-ink bg-retro-blue text-cream'
                : 'text-ink-muted hover:bg-cream-2 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="rainbow-bar" aria-hidden="true"></div>
</header>

<script>
  function renderClock() {
    var clock = document.getElementById('osd-clock');
    if (!clock) return;
    var d = new Date();
    var pad = function (n) { return String(n).padStart(2, '0'); };
    clock.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
  }

  // One persistent timer updates whichever #osd-clock element is currently in
  // the DOM, so it keeps ticking across ClientRouter page transitions.
  renderClock();
  setInterval(renderClock, 1000);
  // ClientRouter swaps the header on navigation; re-render the clock on
  // `astro:after-swap` so it never shows the server-rendered 00:00:00.
  document.addEventListener('astro:after-swap', renderClock);

  // Mobile menu: delegated, so it also works on the re-rendered header.
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var btn = target.closest('#menu-toggle');
    if (!btn) return;
    var menu = document.getElementById('mobile-menu');
    if (!menu) return;
    menu.classList.toggle('hidden');
    var open = !menu.classList.contains('hidden');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
