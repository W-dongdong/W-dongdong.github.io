---
interface Props {
  index: string;
  title: string;
  class?: string;
}

const { index, title, class: className } = Astro.props;
---

<div class:list={['flex items-baseline gap-3', className]}>
  <span class="eyebrow">{index}</span>
  <h2 class="font-display text-xl text-ink">{title}</h2>
</div>
<div class="rule mt-3" aria-hidden="true"></div>
