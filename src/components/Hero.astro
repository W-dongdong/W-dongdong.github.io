---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpg';

const directions = ['Robotics', 'Embedded Systems', 'Control Systems'];
---

<section class="card p-6">
  <div class="flex items-center gap-5">
    <Image
      src={profile}
      alt="Portrait of WU Yandong"
      width={192}
      height={192}
      densities={[1, 2]}
      class="avatar h-24 w-24 flex-none object-cover"
      loading="eager"
    />
    <div>
      <h1 class="font-display text-2xl leading-tight text-ink">WU Yandong</h1>
      <p class="crt-text mt-1.5 text-base leading-tight text-ink-muted">
        The Hong Kong Polytechnic University
      </p>
      <p class="crt-text text-base leading-tight text-ink-muted">
        Bachelor of Engineering in Electrical Engineering
      </p>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-1.5">
    {directions.map((d) => (
      <span class="tag">{d}</span>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a href="/projects" class="btn btn--primary">View Projects</a>
    <a href="/MyCV.pdf" class="btn">Download Résumé</a>
  </div>
</section>
