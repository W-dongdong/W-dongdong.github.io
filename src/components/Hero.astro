---
const directions = ['Robotics', 'Embedded Systems', 'Control Systems'];
---

<section class="retro-card retro-card--red scanlines p-6">
  <!-- Avatar placeholder -->
  <div
    class="relative h-28 w-28 overflow-hidden border-2 border-ink bg-retro-blue shadow-[5px_5px_0_var(--red)]"
    aria-hidden="true"
  >
    <div class="flex h-full items-center justify-center">
      <span class="crt-text text-2xl text-retro-amber">NO SIGNAL</span>
    </div>
    <div class="color-bars absolute inset-x-0 bottom-0"></div>
  </div>

  <h1 class="mt-5 font-display text-3xl leading-tight text-ink sm:text-4xl">
    WU Yandong
  </h1>

  <p class="mt-4 text-base leading-snug text-ink">The Hong Kong Polytechnic University</p>
  <p class="mt-1 text-sm leading-snug text-ink-muted">Bachelor of Engineering in Electrical Engineering</p>

  <div class="mt-4 flex flex-wrap gap-2">
    {directions.map((d) => (
      <span class="crt-tag">{d}</span>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a href="/projects" class="retro-btn retro-btn--primary">View Projects</a>
    <a href="/MyCV.pdf" class="retro-btn">Download Résumé</a>
  </div>
</section>
