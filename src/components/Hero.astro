---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpg';

const directions = ['Robotics', 'Embedded Systems', 'Control Systems'];
---

<section class="card p-6">
  <p class="crt-text flex items-center gap-2.5 text-xs text-ink-muted">
    <span class="pulse-dot" aria-hidden="true"></span>
    Open to collaboration
  </p>

  <Image
    src={profile}
    alt="Portrait of WU Yandong"
    width={192}
    height={192}
    densities={[1, 2]}
    class="avatar mt-5 h-24 w-24 object-cover"
    loading="eager"
  />

  <h1 class="mt-4 font-display text-2xl leading-tight text-ink">WU Yandong</h1>

  <p class="crt-text mt-2.5 text-sm leading-snug text-ink-muted">
    The Hong Kong Polytechnic University
  </p>
  <p class="crt-text text-sm leading-snug text-ink-muted">
    Bachelor of Engineering in Electrical Engineering
  </p>

  <div class="mt-5 flex flex-wrap gap-1.5">
    {directions.map((d) => (
      <span class="tag">{d}</span>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a href="/projects" class="btn btn--primary">View Projects</a>
    <a href="/MyCV.pdf" class="btn">Download Résumé</a>
  </div>
</section>
