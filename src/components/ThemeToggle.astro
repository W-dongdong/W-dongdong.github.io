---
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex items-center gap-1.5 rounded-full border border-line bg-cream-2 px-2.5 py-1.5 text-ink transition-colors hover:border-line-strong hover:text-retro-blue"
  aria-label="Toggle theme"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="h-4 w-4"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364-6.364l-1.06 1.06M6.696 17.304l-1.061 1.06m12.729 0l-1.061-1.06M6.696 6.696l-1.06-1.06M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"
    />
  </svg>
  <span data-label class="crt-text text-sm leading-none">System</span>
</button>

<script>
  var modes = ['light', 'dark', 'system'];
  var labels = { light: 'Light', dark: 'Dark', system: 'System' };

  function getMode() {
    var s = null;
    try { s = localStorage.getItem('theme'); } catch (e) {}
    return s === 'light' || s === 'dark' || s === 'system' ? s : 'system';
  }

  function render(btn) {
    if (!btn) return;
    var label = btn.querySelector('[data-label]');
    if (label) label.textContent = labels[getMode()];
    btn.setAttribute('aria-label', 'Theme: ' + labels[getMode()]);
  }

  function resolve(mode) {
    return mode === 'light' || mode === 'dark'
      ? mode
      : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  }

  function apply(mode) {
    document.documentElement.setAttribute('data-theme', resolve(mode));
    if (mode === 'system') {
      try { localStorage.removeItem('theme'); } catch (e) {}
    } else {
      try { localStorage.setItem('theme', mode); } catch (e) {}
    }
    render(document.getElementById('theme-toggle'));
  }

  // The incoming page is applied with its server-rendered <html> attributes,
  // which carry no `data-theme`. Fixing that in `astro:after-swap` is too late:
  // the document is already in the DOM by then, so the dark theme paints one
  // light frame on every navigation. Set it on the incoming document instead.
  document.addEventListener('astro:before-swap', function (event: any) {
    var incoming: Document | undefined = event.newDocument;
    if (!incoming) return;
    var mode = getMode();
    incoming.documentElement.setAttribute('data-theme', resolve(mode));
    var label = incoming.querySelector('#theme-toggle [data-label]');
    if (label) label.textContent = labels[mode];
  });

  // Safety net for anything the swap path above did not cover.
  document.addEventListener('astro:after-swap', function () {
    apply(getMode());
  });

  // Delegated click, so the button keeps working on the re-rendered header.
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var btn = target.closest('#theme-toggle');
    if (!btn) return;
    var cur = getMode();
    var next = modes[(modes.indexOf(cur) + 1) % modes.length];
    apply(next);
  });

  // Initial render.
  render(document.getElementById('theme-toggle'));

  // Keep system mode in sync when the OS colour scheme changes.
  var mq = window.matchMedia('(prefers-color-scheme: dark)');
  var onChange = function () {
    if (getMode() === 'system') {
      document.documentElement.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
    }
  };
  if (mq.addEventListener) mq.addEventListener('change', onChange);
  else if (mq.addListener) mq.addListener(onChange);
</script>
