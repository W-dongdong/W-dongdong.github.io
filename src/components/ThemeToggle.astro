---
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex items-center gap-1.5 border-2 border-ink bg-cream-2 px-2.5 py-1.5 text-sm font-bold text-ink shadow-[3px_3px_0_var(--blue)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_var(--blue)]"
  aria-label="Toggle theme"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    stroke="currentColor"
    class="h-4 w-4"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364-6.364l-1.06 1.06M6.696 17.304l-1.061 1.06m12.729 0l-1.061-1.06M6.696 6.696l-1.06-1.06M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"
    />
  </svg>
  <span data-label>System</span>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;

    var modes = ['light', 'dark', 'system'];
    var labels = { light: 'Light', dark: 'Dark', system: 'System' };

    function getMode() {
      var s = null;
      try { s = localStorage.getItem('theme'); } catch (e) {}
      return s === 'light' || s === 'dark' || s === 'system' ? s : 'system';
    }

    function render(mode) {
      var label = btn.querySelector('[data-label]');
      if (label) label.textContent = labels[mode];
      btn.setAttribute('aria-label', 'Theme: ' + labels[mode]);
    }

    function apply(mode) {
      var resolved = mode === 'light' || mode === 'dark'
        ? mode
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', resolved);
      if (mode === 'system') {
        try { localStorage.removeItem('theme'); } catch (e) {}
      } else {
        try { localStorage.setItem('theme', mode); } catch (e) {}
      }
      render(mode);
    }

    render(getMode());

    btn.addEventListener('click', function () {
      var cur = getMode();
      var next = modes[(modes.indexOf(cur) + 1) % modes.length];
      apply(next);
    });

    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    var onChange = function () {
      if (getMode() === 'system') {
        document.documentElement.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
      }
    };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
    else if (mq.addListener) mq.addListener(onChange);
  })();
</script>
