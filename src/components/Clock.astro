---
// Live local time for the visitor, in the site's terminal type.
// Decorative, so it is hidden from assistive tech.
---

<span
  id="site-clock"
  class="hidden items-center gap-2.5 sm:inline-flex"
  aria-hidden="true"
>
  <span class="h-2 w-2 rounded-full bg-retro-blue"></span>
  <span data-time class="crt-text text-lg leading-none text-ink">--:--:--</span>
</span>

<script>
  var pad = function (n: number) {
    return String(n).padStart(2, '0');
  };

  function clockText() {
    var d = new Date();
    return pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
  }

  function renderClock() {
    var out = document.querySelector('#site-clock [data-time]');
    if (out) out.textContent = clockText();
  }

  // The incoming document carries the server-rendered placeholder. Fill it in
  // before the swap so the header never shows a frame of `--:--:--`.
  document.addEventListener('astro:before-swap', function (event: any) {
    var incoming: Document | undefined = event.newDocument;
    var out = incoming?.querySelector('#site-clock [data-time]');
    if (out) out.textContent = clockText();
  });

  // One persistent timer updates whichever clock element is currently in the
  // DOM, so it keeps ticking across ClientRouter page transitions.
  renderClock();
  setInterval(renderClock, 1000);
  document.addEventListener('astro:after-swap', renderClock);
</script>
