---
import TagBadge from './TagBadge.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date;
      tags: string[];
      lang: 'en' | 'zh';
    };
  };
}

const { post } = Astro.props;
const dateStr = post.data.pubDate.toISOString().slice(0, 10);
const langLabel = post.data.lang === 'zh' ? '中文' : 'English';
---

<a
  href={`/blog/${post.id}`}
  class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand hover:shadow-md dark:border-slate-700 dark:bg-[#1e293b] dark:hover:border-sky-400"
>
  <div class="flex items-center justify-between gap-2">
    <time datetime={dateStr} class="text-xs text-slate-400 dark:text-slate-500">{dateStr}</time>
    <span class="rounded-full border border-brand/30 px-2 py-0.5 text-xs font-medium text-brand dark:border-sky-400/40 dark:text-sky-300">
      {langLabel}
    </span>
  </div>
  <h3 class="mt-2 text-lg font-semibold text-slate-900 transition-colors group-hover:text-brand dark:text-white dark:group-hover:text-sky-300">
    {post.data.title}
  </h3>
  {post.data.description && (
    <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-300">{post.data.description}</p>
  )}
  {post.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {post.data.tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>
  )}
</a>
